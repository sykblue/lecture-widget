{
  "name": "강의 요약 위젯",
  "short_name": "강의 요약",
  "description": "ZEP 강의 · YouTube 영상 소리를 받아 적고 몇 분마다 요약하는 위젯 (설치 없음 · API 키 없이 로컬)",
  "lang": "ko",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0e13",
  "theme_color": "#121318",
  "icons": [
    {
      "src": "pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "pwa/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ]
}